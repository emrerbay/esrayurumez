# PostgreSQL - Vercel/canlı için MUTLAKA Connection pooler (Transaction mode) kullanın!
# Supabase: Project Settings → Database → "Connection string" → "Transaction" (port 6543, host ...pooler...)
# Direct (5432) kullanırsanız "max clients reached" hatası alırsınız.
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
SESSION_SECRET=your_32_char_minimum_secret_here_change_me
# Yönetim girişi: kullanıcı adı ve şifre
ADMIN_USER=admin
# Sadece development: düz şifre (giriş sorununda önce bunu kullanın)
ADMIN_PASS=esrayurumez123
# Production için bcrypt hash (yukarıdaki şifreyle aynı)
ADMIN_PASS_HASH=$2a$10$457ouIMnT5OQsDClSJS3IuXWuVcAw/KvJd2YJQ34yPCuOKGNKe//S
SITE_URL=https://esrayurumez.com.tr/
NODE_ENV=development

# Yorum bildirim e-postası için SMTP (Admin → Site Ayarları’nda bildirim adresi girilir)
# Gmail: Uygulama şifresi kullanın (Hesap Güvenliği → 2 adımlı doğrulama → Uygulama şifreleri)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your@gmail.com
